{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Central Brain",
  "version": "1.3.0",
  "identifier": "com.chrismeehan.centralbrain.menubar",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:4317"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Central Brain",
        "url": "http://localhost:4317/",
        "width": 460,
        "height": 680,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGREY1RkU2NjdFNEFEMDQKUldRRXJlUm41bC9mMzFCQmxwOHBUaEVxYkhwVnFTN1dGdHo3Uk9FaWJkQ05jeERXeGJoU08xTjAK",
      "endpoints": [
        "https://github.com/chrismeehan20/central-brain/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../dist/server-bundle.mjs",
      "../dist/client",
      "../hooks"
    ]
  }
}
