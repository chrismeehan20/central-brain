{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Central Brain",
  "version": "0.1.0",
  "identifier": "com.chrismeehan.centralbrain.menubar",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:4317"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Central Brain",
        "url": "http://localhost:4317/",
        "width": 460,
        "height": 680,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
