# Optional, and only one of two ways to set this. The app itself has a setup
# panel (first-run card, or the ⚙ button) that stores the key in the user-data
# dir — that is the only path that works in a packaged .app, whose sidecar runs
# with cwd / and so never loads this file. Setting it here wins over a key saved
# in the app, which is convenient for `npm run dev`.
#
# Without a key from either source the dashboard still works fully — projects,
# alerting, and GitHub status don't need it. Only the AI "what's left" one-line
# summaries and the daily digest are skipped.
ANTHROPIC_API_KEY=

# Port the server listens on (default 4317).
# PORT=4317

# ---- AI cost controls (all optional) ----
# Model used for summaries, project detail, and the daily digest.
# AI_MODEL=claude-haiku-4-5-20251001

# Hard ceiling on real Anthropic calls per day, shared across summaries,
# project detail, and the digest. Poller stops and manual refresh returns
# cached once hit. Resets at local midnight.
# AI_DAILY_CALL_CAP=200

# A forced/manual refresh within this window (ms) of the last successful one
# is a no-op that returns the cached result instead of spending a call.
# AI_REFRESH_DEBOUNCE_MS=60000

# Background refresh intervals (ms). Both are hash-gated, so an unchanged
# project costs nothing regardless of how often they fire.
# SUMMARY_POLL_MS=1800000   # 30 min
# DETAIL_POLL_MS=3600000    # 60 min

# How long a quiet Codex session keeps a (demoted) "maybe stuck" flag on the
# attention panel before it's cleared entirely (ms). Default 24 h.
# CODEX_ABANDONED_MS=86400000
