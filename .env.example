# Optional. Without this, the dashboard still works fully — projects,
# alerting, and GitHub status don't need it. Only the AI "what's left"
# one-line summaries are skipped until it's set.
ANTHROPIC_API_KEY=

# Port the server listens on (default 4317).
# PORT=4317

# ---- AI cost controls (all optional) ----
# Hard ceiling on real Anthropic calls per day, shared across summaries and
# project detail. Poller stops and manual refresh returns cached once hit.
# AI_DAILY_CALL_CAP=200

# A forced/manual refresh within this window (ms) of the last successful one
# is a no-op that returns the cached result instead of spending a call.
# AI_REFRESH_DEBOUNCE_MS=60000

# Background refresh intervals (ms). Both are hash-gated, so an unchanged
# project costs nothing regardless of how often they fire.
# SUMMARY_POLL_MS=1800000   # 30 min
# DETAIL_POLL_MS=3600000    # 60 min
